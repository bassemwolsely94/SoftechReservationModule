# Coverage for the backend suite (CI: coverage run manage.py test). Floor: 73% in ci.yml —
# set by R7 (2026-11-05) from the measured 73.97%; raise it, never lower it.
[run]
source = apps, core, config
omit =
    */migrations/*
    apps/tests/*
    */management/commands/*

[report]
skip_empty = True
