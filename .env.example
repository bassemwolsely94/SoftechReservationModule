# ElRezeiky Pharmacy Platform — Environment Variables
# Copy to .env and fill in your values

# Django
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_SERVER_IP

# PostgreSQL
PG_NAME=elrezeiky_db
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_HOST=localhost
PG_PORT=5432

# Sybase ASE 12.5 (SOFTECH)
# Sync jobs use these credentials (read-only operations).
# The Discount Approval Module uses the same credentials to execute approved writes.
SYBASE_DSN=SOFTECH
SYBASE_USER=your_softech_user
SYBASE_PASSWORD=your_softech_password
# ERP usercode stamped on items.usercode when the approval module writes back to Softech.
# Must be a valid usercode in SOFTECHDB9.dbo.users (e.g. '00099' for a service account).
ERP_SERVICE_USERCODE=00001

# CORS (React frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://YOUR_SERVER_IP:3000

# AI Enrichment — multi-provider fallback chain
# Provider 1: Gemini primary (https://aistudio.google.com/ → "Get API key")
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=10

# Provider 2: Gemini secondary (second Google account — separate free-tier quota)
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_MODEL_2=gemini-2.5-flash

# Provider 3: OpenAI fallback (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_RPM=3

# ── Supplier-invoice writeback (apps/invoices Track B) ─────────────────────────
# Master kill-switch. Keep False until validated on SOFTECH_TEST_HOST — the final
# purchase insert (doccode 10/120) fires SOFTECH's stock/cost/supplier-balance triggers.
INVOICE_WRITER_ENABLED=False
INVOICE_WRITER_PROFILE=test
INVOICE_DEFAULT_USERCODE=
INVOICE_WRITE_CHARSET=cp1256
# Write confirmed vendor_item_code → SOFTECH itemssuppliers.suppitemcode (trigger-free
# master data; UPDATE the existing supplier↔item link, never clobber a different code).
# Seeds first-invoice code→item resolution. Safe to enable independently of the writer.
INVOICE_SUPPLIER_ITEM_WRITE_ENABLED=False

# ── SOFTECH Connector Profiles ─────────────────────────────────────────────────
# Set SOFTECH_PROFILE to 'dev', 'test', or 'prod' (default: prod)
SOFTECH_PROFILE=prod
SOFTECH_DEV_HOST=192.168.1.100
SOFTECH_DEV_PORT=5000
SOFTECH_TEST_HOST=192.168.1.101
SOFTECH_TEST_PORT=5000
SOFTECH_PROD_HOST=192.168.1.10
SOFTECH_PROD_PORT=5000

# ── SOFTECH PIC Points Integration ─────────────────────────────────────────────
# SOFTECH uses a 3-table points architecture:
#   picpoints (transaction log) -> tr_picpoints trigger -> localcustomers.picpoints (balance)
# We INSERT into picpoints (same as the ERP screen). The trigger updates the balance.
#
# Operator label stored in picpoints.vf2 for CRM-originated adjustments.
SOFTECH_POINTS_OPERATOR=CRM
# Branch code stamped in picpoints.branchcode for CRM adjustments (max 5 chars).
# Use your call-centre branch code, or leave as CRM for a neutral identifier.
SOFTECH_CRM_BRANCHCODE=CRM

# ── WhatsApp Business Platform ─────────────────────────────────────────────────
# Meta Cloud API — https://developers.facebook.com/
WHATSAPP_TOKEN=your_meta_cloud_api_bearer_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_API_VERSION=v19.0

# Omni (CEP) — Fernet key for per-account provider credentials (multi-number WhatsApp).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OMNI_CREDENTIALS_KEY=
# Meta Graph webhook (Messenger + Instagram — doc 15 Phase 3)
META_GRAPH_VERIFY_TOKEN=your_meta_graph_verify_token
META_GRAPH_APP_SECRET=your_meta_graph_app_secret

# ── Issabel PBX / Asterisk AMI ─────────────────────────────────────────────────
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=your_ami_username
AMI_SECRET=your_ami_secret
# ── Issabel CDR database (call-center call counts, doc 16 Phase 5) ──────────────
# Read-only MySQL/MariaDB connection to the Asterisk CDR. Leave USER blank to disable.
ISSABEL_CDR_HOST=192.168.1.155
ISSABEL_CDR_PORT=3306
ISSABEL_CDR_DB=asteriskcdrdb
ISSABEL_CDR_TABLE=cdr
ISSABEL_CDR_USER=
ISSABEL_CDR_PASSWORD=
# Supervisor listen/whisper (ChanSpy) + recording playback — doc 15 Phase 2
AMI_SPY_CONTEXT=from-internal
AMI_CHANNEL_TECH=SIP
PBX_RECORDINGS_DIR=
PBX_RECORDINGS_URL_BASE=

# ── Frontend base URL (used in referral code links + portal magic links) ──────
FRONTEND_BASE_URL=https://app.elrezeiky.com

# ── Customer self-service portal (external; magic-link auth via WhatsApp) ──────
# Token lifetimes in seconds. Short by design.
PORTAL_MAGIC_LINK_TTL=900          # magic link valid 15 min
PORTAL_SESSION_TTL=43200           # customer session valid 12 h
PORTAL_REQUEST_LINK_RATE=5/min     # throttle: magic-link requests per phone+IP
PORTAL_AUTH_RATE=10/min            # throttle: token exchanges per IP

# ── Web Push (VAPID) ───────────────────────────────────────────────────────────
# Browser push notifications so the in-app bell stays "alive" when the tab/app
# is closed. Generate ONE key pair (base64url) and reuse it everywhere, e.g.:
#   npx web-push generate-vapid-keys
# Leave empty to disable Web Push (the backend helper then no-ops).
# NOTE: iOS delivers Web Push only to an INSTALLED PWA (Safari 16.4+).
WEBPUSH_VAPID_PUBLIC_KEY=your_vapid_public_key_base64url
WEBPUSH_VAPID_PRIVATE_KEY=your_vapid_private_key_base64url
WEBPUSH_VAPID_ADMIN_EMAIL=admin@elrezeiky.com

# ── Scheduler ──────────────────────────────────────────────────────────────
# NEVER set to True — scheduler runs in its own dedicated process:
#   python manage.py run_scheduler
# Running it inside the web process causes thread-pool crashes on autoreload
# and is unsafe under Gunicorn/Daphne multi-worker deployments.
SCHEDULER_AUTOSTART=False
