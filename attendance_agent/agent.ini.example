# Copy to agent.ini on the agent PC and fill in. Never commit the filled copy.

[erp]
# The ERP address. This is the one setting to change at the VPS switch-over.
# Plain http is for the office network or VPN only; use https on the VPS.
url = http://192.0.2.10:8000
# Printed once by: manage.py issue_attendance_agent <name>
secret = paste-the-agent-secret-here

[agent]
# Folder for the spool, the saved machine list and the log. Must survive restarts.
# Leave out to use "agent_state" next to this file.
# state_dir = C:\ElRezeiky\agent\state

[comm_keys]
# Only for a machine that asks for a comm key: <machine serial> = <number>
# SERIALNUMBER = 12345

# Optional: also read punches from the Linked Gates HR portal (SQL Server on this PC).
# Read-only. Needs ODBC Driver 18 for SQL Server and `pip install pyodbc`. Leave the
# whole section out on an agent that does not use Linked Gates.
# [linkedgates]
# server = .\SQLEXPRESS
# database = Linked_ERP_HR_v1
# trusted = yes
# With trusted = yes, this agent's Windows account must be granted only db_datareader plus
# the column DENYs from the IT note, and must never be an owner.
# With trusted = no, give a SQL login that can only read:
# user = readonly_login
# password = its-password
# The first load starts from this date (default: the 1st of last month).
# first_load_from = 2026-10-01
