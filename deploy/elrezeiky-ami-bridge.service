[Unit]
Description=ElRezeiky Pharmacy Platform — Issabel AMI event bridge (screen-pop, call logs, live calls)
# Issabel sits behind the HQ tunnel (runbook §5); Redis carries the screen-pop pushes.
After=network-online.target postgresql.service redis-server.service zerotier-one.service elrezeiky-tunnel-watch.service
Wants=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=elrezeiky
Group=elrezeiky
WorkingDirectory=/opt/elrezeiky

EnvironmentFile=/opt/elrezeiky/.env

# Exactly ONE bridge may run (office PC OR this server, never both) — two bridges
# create every call twice.
ExecStart=/opt/elrezeiky/venv/bin/python manage.py run_ami_bridge

# The bridge reconnects on its own; this only covers a crash of the process itself.
Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=elrezeiky-ami-bridge
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
