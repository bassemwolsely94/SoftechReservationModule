[Unit]
Description=ElRezeiky — export jobs (builds Excel/CSV files off the web processes, performance Stage 4)
# Installing it is an owner step: runbook §13.8. The web processes only leave jobs for it once
# EXPORT_JOBS_RUNNER=service is in /opt/elrezeiky/.env (set it AFTER this unit is running).
After=network-online.target postgresql.service redis-server.service elrezeiky-web.service
Wants=network-online.target postgresql.service
# Not bound to the web unit: either may restart without the other

[Service]
Type=simple
User=elrezeiky
Group=elrezeiky
WorkingDirectory=/opt/elrezeiky

EnvironmentFile=/opt/elrezeiky/.env

# One job at a time, no JVM (exports that read SOFTECH live stay on the web process, design §10).
# A job cut off by a stop/restart is reported failed at the next start; the user presses export again.
ExecStart=/opt/elrezeiky/venv/bin/python manage.py run_export_jobs

Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

# Keep a big export from starving the web processes and PostgreSQL on the 8 GB / 4 vCPU plan
MemoryHigh=1G
MemoryMax=1536M
CPUQuota=100%
Nice=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=elrezeiky-jobs

# The largest export (purchasing pivot) takes ~2-3 min; give the current one time to finish
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
