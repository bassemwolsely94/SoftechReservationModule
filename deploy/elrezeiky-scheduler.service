[Unit]
Description=ElRezeiky Pharmacy Platform — Background Scheduler (APScheduler)
# Redis (channels) and the SOFTECH tunnel (ZeroTier primary, SSTP watchdog) must be up first;
# a unit that does not exist on this machine is ignored.
After=network-online.target postgresql.service redis-server.service zerotier-one.service elrezeiky-tunnel-watch.service elrezeiky-web.service
Wants=network-online.target postgresql.service redis-server.service
# Do NOT use BindsTo — the scheduler must survive a web restart and vice versa

[Service]
Type=simple
User=elrezeiky
Group=elrezeiky
WorkingDirectory=/opt/elrezeiky

EnvironmentFile=/opt/elrezeiky/.env

ExecStart=/opt/elrezeiky/venv/bin/python manage.py run_scheduler

# Restart aggressively — sync jobs must keep running even if there's a transient error
Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=elrezeiky-scheduler

# Allow up to 90 seconds for in-flight sync jobs to complete before SIGKILL
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
