[Unit]
Description=ElRezeiky Pharmacy Platform — Daphne ASGI Web Server
# Redis (channels) and the SOFTECH tunnel (ZeroTier primary, SSTP watchdog) must be up first;
# a unit that does not exist on this machine is ignored.
After=network-online.target postgresql.service redis-server.service zerotier-one.service elrezeiky-tunnel-watch.service
Wants=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=elrezeiky
Group=elrezeiky
WorkingDirectory=/opt/elrezeiky

# Load environment from .env file
EnvironmentFile=/opt/elrezeiky/.env

# Daphne serves both HTTP and WebSocket (Django Channels)
# Bind to 127.0.0.1 only — Nginx sits in front and handles public traffic
ExecStart=/opt/elrezeiky/venv/bin/daphne \
    -b 127.0.0.1 \
    -p 8000 \
    --proxy-headers \
    config.asgi:application

# Restart policy: always restart, but back off if it crashes in a tight loop
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Logging — goes to journald, readable with: journalctl -u elrezeiky-web -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=elrezeiky-web

# Give the process time to shut down cleanly before SIGKILL
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
