# ── ElRezeiky — PRODUCTION (LDC VPS) .env template ───────────────────────────
# /opt/elrezeiky/app/.env, owner elrezeiky, chmod 600. Runbook §8.2; go-live: docs/GO_LIVE_CHECKLIST.md.
#
# FIRST BOOT IS READ-ONLY: this file starts as a reader (WRITER_INSTANCE=False, SOFTECH_READ_ONLY=True,
# every writer flag False). Only cutover step 11.6 turns this server into the ONE writer — after the
# office copy has passed `manage.py writer_status --expect reader` and has been stopped (P-54).
# Never repeat a key: the web process and the scheduler refuse to start on a duplicate.
# Never copy Windows paths (C:\…) from the office .env.

# ── Django ───────────────────────────────────────────────────────────────────
DEBUG=False
DJANGO_ADMIN_ENABLED=False       # no 2FA on Django admin — True only for a maintenance window
SECRET_KEY=CHANGE                # python3 -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=elrezeikyapp.dawalvry.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://elrezeikyapp.dawalvry.com
CORS_ORIGINS=https://elrezeikyapp.dawalvry.com
FRONTEND_BASE_URL=https://elrezeikyapp.dawalvry.com
BEHIND_HTTPS_PROXY=True
SCHEDULER_AUTOSTART=False        # the scheduler is its own service (elrezeiky-scheduler)
MEDIA_ACCEL_REDIRECT=True
REDIS_URL=redis://127.0.0.1:6379/0

# ── Security switches (each goes to enforce on its own runbook step, owner's call) ──
RBAC_ENFORCEMENT=log             # → enforce at cutover once the rbac log is quiet
NETWORK_HEADER_TRUSTED=True      # ONLY because nginx + elrezeiky-proxy-headers.conf is the sole way in (N1)
NETWORK_UNTRUSTED_ZONE=external
NETWORK_POLICY_ENFORCEMENT=log   # off | log | enforce (N3)
NETWORK_PROXY_KEY=CHANGE         # openssl rand -hex 32 — same value as /etc/nginx/elrezeiky-proxy-key.conf (N3)
NUM_PROXIES=1
SOFTECH_GATE_ENFORCEMENT=log     # N4
BULK_READ_ENFORCEMENT=log        # N5
PUBLIC_API_ENFORCEMENT=log       # N6

# ── PostgreSQL ───────────────────────────────────────────────────────────────
PG_NAME=elrezeiky_db
PG_USER=elrezeiky
PG_PASSWORD=CHANGE
PG_HOST=localhost
PG_PORT=5432

# ── SOFTECH (through the ZeroTier / SSTP tunnel) ─────────────────────────────
SOFTECH_READ_ONLY=True           # kill-switch: False only at cutover 11.6, together with WRITER_INSTANCE=True
WRITER_INSTANCE=False            # P-54: True on this server only, and only after the office is a stopped reader
SYBASE_HOST=192.168.1.8
SYBASE_PORT=5000
SYBASE_USER=CHANGE
SYBASE_PASSWORD=CHANGE
SOFTECH_PROFILE=CHANGE           # from the office .env
SOFTECH_BRANCH_HOST_OVERRIDE=    # EMPTY in production → real branch hosts from the Branch table
SOFTECH_PROBES_ENABLED=False

# ── Every SOFTECH writer flag (config/writers.py WRITER_FLAGS) — all False on first boot ──
# At 11.6 set each to the signed-off value (docs/product-review/06_SPEC_P-54 appendix), one module
# at a time, restart web + scheduler, read the result back in SOFTECH before the next.
ISR_WRITER_ENABLED=False
ISR_AUTO_APPROVE_ENABLED=False
SALES_RATE_WRITER_ENABLED=False
COVERAGE_WRITER_ENABLED=False
COVERAGE_WRITE_MAXQTY=False
COVERAGE_AUTO_TOPUP_ENABLED=False
DEMAND_ENGINE_SCHEDULE_ENABLED=False
INVOICE_WRITER_ENABLED=False
INVOICE_SUPPLIER_ITEM_WRITE_ENABLED=False
SHORTAGE_SOFTECH_WRITE_ENABLED=False
AP_RECONCILE_WRITER_ENABLED=False
AP_RECONCILE_UPDATE_PATIENTDATA=False
POS_OFFERS_EXECUTION_ENABLED=False
POS_OFFERS_POSDISCP_WRITE_ENABLED=False
POS_OFFERS_PROMO_WRITE_ENABLED=False
CUSTOMER_BRANCH_COPY_WRITE_ENABLED=False
POINTS_REMOVAL_WRITE_ENABLED=False
POS_WRITER_ENABLED=False
POS_CANCEL_WRITE_ENABLED=False
PRICING_SOFTECH_WRITE_ENABLED=False
REPLICATION_REPAIR_ENABLED=False
LOYALTY_SOFTECH_WRITE_ENABLED=False
PERSONAL_COMMENT_WRITE_ENABLED=False
REPLACEMENT_POSTING_ENABLED=False
INSURANCE_SOFTECH_WRITE_ENABLED=False
CUSTOMER_MERGE_WRITE_ENABLED=False

# ── New features: ship dark, owner turns each on after go-live (none writes to SOFTECH) ──
CAMERA_SCAN_ENABLED=False        # Project 2: 📷 barcode button on item search
DAILY_COUNT_ENABLED=False        # Project 2: daily blind counts (+ BranchSettings pilot switch per branch)
MISSED_SALES_ENABLED=False       # Project 3: unsold POS items → reservation suggestions
MISSED_CALL_CALLBACKS_ENABLED=False  # Project 3: missed calls → automatic call-backs
DRUG_ASSISTANT_ENABLED=False     # Project 4: staff drug assistant
COUNSELLING_CONTENT_ENABLED=False    # Project 4: pharmacist-approved usage sheets
COUNSEL_CARD_SEND_ENABLED=False  # Project 4: WhatsApp counselling card — needs the approved counsel_card template
# COUNSEL_PHONE_HASH_KEY=<openssl rand -hex 32>   # Project 4: uncomment and set ONCE before the first card is
#   sent, then never change it (a new key forgets every opt-out). Same value as the office if the office ever set one.
USAGE_PRINT_ENABLED=False        # Project 5 usage-instruction slip (read-only screen, ships dark)
PHONE_ALERTS_SEND_ENABLED=False  # staff phone alerts over WhatsApp — needs the staff-alerts number + approved templates
MORNING_BRIEF_SEND_ENABLED=False # 09:00 Cairo morning brief to recipients — same WhatsApp prerequisites

# ── External channels: EMPTY until cutover 11.7 (nothing reaches customers from a rehearsal) ──
OMNI_CREDENTIALS_KEY=CHANGE      # the SAME Fernet key as the office (encrypted channel credentials)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_APP_SECRET=
META_GRAPH_VERIFY_TOKEN=
REFILL_REMINDER_SEND_ENABLED=False
SMS_PROVIDER=                    # W-1: OFF until the SMS company is chosen
AMI_HOST=
AMI_USER=
AMI_SECRET=
ISSABEL_CDR_USER=
ISSABEL_CDR_PASSWORD=
WEBPUSH_VAPID_PUBLIC_KEY=        # the office pair — a new pair forces every user to re-subscribe
WEBPUSH_VAPID_PRIVATE_KEY=

# ── Local OCR (runbook §8.4) ─────────────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_TESSDATA_PREFIX=       # empty → the project's ocr_tessdata/ (copied by hand, git-ignored)
OMP_THREAD_LIMIT=1
PADDLE_OCR_URL=http://127.0.0.1:8077/boxes
INVOICE_OCR_ENGINE=auto          # tesseract = 100% local
INVOICE_OCR_ESCALATE_THRESHOLD=0.6
GEMINI_API_KEY=                  # empty forbids cloud OCR
OPENAI_API_KEY=
WHISPER_ENABLED=False            # RAM budget on 8 GB
