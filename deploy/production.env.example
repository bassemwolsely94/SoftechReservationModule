# ── ElRezeiky — PRODUCTION (LDC VPS) .env template ───────────────────────────
# /opt/elrezeiky/app/.env, owner elrezeiky, chmod 600. Runbook §8.2; go-live: docs/GO_LIVE_CHECKLIST.md.
#
# FIRST BOOT IS READ-ONLY: this file starts as a reader (WRITER_INSTANCE=False, SOFTECH_READ_ONLY=True,
# every writer flag False). Only cutover step 11.6 turns this server into the ONE writer — after the
# office copy has passed `manage.py writer_status --expect reader` and has been stopped (P-54).
# Never repeat a key: the web process and the scheduler refuse to start on a duplicate.
# Never copy Windows paths (C:\…) from the office .env.
# Comments go on their own line: python-decouple keeps anything after = as the value, so a note beside a value stops the app at boot.

# ── Django ───────────────────────────────────────────────────────────────────
DEBUG=False
# no 2FA on Django admin — True only for a maintenance window
DJANGO_ADMIN_ENABLED=False
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE
ALLOWED_HOSTS=elrezeikyapp.dawalvry.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://elrezeikyapp.dawalvry.com
CORS_ORIGINS=https://elrezeikyapp.dawalvry.com
FRONTEND_BASE_URL=https://elrezeikyapp.dawalvry.com
BEHIND_HTTPS_PROXY=True
# the scheduler is its own service (elrezeiky-scheduler)
SCHEDULER_AUTOSTART=False
MEDIA_ACCEL_REDIRECT=True
REDIS_URL=redis://127.0.0.1:6379/0

# ── Security switches (each goes to enforce on its own runbook step, owner's call) ──
# → enforce at cutover once the rbac log is quiet
RBAC_ENFORCEMENT=log
# comma list; enforced even while RBAC_ENFORCEMENT=log (Finance GL ruling) — also gates search + chatter
RBAC_ENFORCED_ROLES=accountant
# ONLY because nginx + elrezeiky-proxy-headers.conf is the sole way in (N1)
NETWORK_HEADER_TRUSTED=True
NETWORK_UNTRUSTED_ZONE=external
# off | log | enforce (N3)
NETWORK_POLICY_ENFORCEMENT=log
# openssl rand -hex 32 — same value as /etc/nginx/elrezeiky-proxy-key.conf (N3)
NETWORK_PROXY_KEY=CHANGE
NUM_PROXIES=1
# N4
SOFTECH_GATE_ENFORCEMENT=log
# N5
BULK_READ_ENFORCEMENT=log
# N6
PUBLIC_API_ENFORCEMENT=log

# ── PostgreSQL ───────────────────────────────────────────────────────────────
PG_NAME=elrezeiky_db
PG_USER=elrezeiky
PG_PASSWORD=CHANGE
PG_HOST=localhost
PG_PORT=5432

# ── SOFTECH (through the ZeroTier / SSTP tunnel) ─────────────────────────────
# kill-switch: False only at cutover 11.6, together with WRITER_INSTANCE=True
SOFTECH_READ_ONLY=True
# P-54: True on this server only, and only after the office is a stopped reader
WRITER_INSTANCE=False
SYBASE_HOST=192.168.1.8
SYBASE_PORT=5000
SYBASE_USER=CHANGE
SYBASE_PASSWORD=CHANGE
# from the office .env
SOFTECH_PROFILE=CHANGE
# EMPTY in production → real branch hosts from the Branch table
SOFTECH_BRANCH_HOST_OVERRIDE=
SOFTECH_PROBES_ENABLED=False

# ── Every SOFTECH writer flag (config/writers.py WRITER_FLAGS) — all False on first boot ──
# At 11.6 set each to the signed-off value (docs/product-review/06_SPEC_P-54 appendix), one module
# at a time, restart web + scheduler, read the result back in SOFTECH before the next.
ISR_WRITER_ENABLED=False
ISR_AUTO_APPROVE_ENABLED=False
SALES_RATE_WRITER_ENABLED=False
COVERAGE_WRITER_ENABLED=False
COVERAGE_WRITE_MAXQTY=False
COVERAGE_AUTO_TOPUP_ENABLED=False
DEMAND_ENGINE_SCHEDULE_ENABLED=False
# finance GL 08:30 daily drafting (draft-now button works regardless)
GL_DRAFTING_SCHEDULE_ENABLED=False
INVOICE_WRITER_ENABLED=False
INVOICE_SUPPLIER_ITEM_WRITE_ENABLED=False
SHORTAGE_SOFTECH_WRITE_ENABLED=False
AP_RECONCILE_WRITER_ENABLED=False
AP_RECONCILE_UPDATE_PATIENTDATA=False
POS_OFFERS_EXECUTION_ENABLED=False
POS_OFFERS_POSDISCP_WRITE_ENABLED=False
POS_OFFERS_PROMO_WRITE_ENABLED=False
CUSTOMER_BRANCH_COPY_WRITE_ENABLED=False
POINTS_REMOVAL_WRITE_ENABLED=False
POS_WRITER_ENABLED=False
POS_CANCEL_WRITE_ENABLED=False
PRICING_SOFTECH_WRITE_ENABLED=False
REPLICATION_REPAIR_ENABLED=False
LOYALTY_SOFTECH_WRITE_ENABLED=False
PERSONAL_COMMENT_WRITE_ENABLED=False
REPLACEMENT_POSTING_ENABLED=False
INSURANCE_SOFTECH_WRITE_ENABLED=False
CUSTOMER_MERGE_WRITE_ENABLED=False

# ── New features: ship dark, owner turns each on after go-live (none writes to SOFTECH) ──
# Project 2: 📷 barcode button on item search
CAMERA_SCAN_ENABLED=False
# Project 2: daily blind counts (+ BranchSettings pilot switch per branch)
DAILY_COUNT_ENABLED=False
# Project 3: unsold POS items → reservation suggestions
MISSED_SALES_ENABLED=False
# Project 3: missed calls → automatic call-backs
MISSED_CALL_CALLBACKS_ENABLED=False
# Project 4: staff drug assistant
DRUG_ASSISTANT_ENABLED=False
# Project 4: pharmacist-approved usage sheets
COUNSELLING_CONTENT_ENABLED=False
# Project 4: WhatsApp counselling card — needs the approved counsel_card template
COUNSEL_CARD_SEND_ENABLED=False
# Project 4: uncomment and set ONCE before the first card is
#   sent, then never change it (a new key forgets every opt-out). Same value as the office if the office ever set one.
# COUNSEL_PHONE_HASH_KEY=<openssl rand -hex 32>
# HR attendance stage 1: fingerprint punch collection (agent endpoints dark)
HR_ATTENDANCE_ENABLED=False
# Data lifecycle: removed files wait 30 days here (same disk as media/, outside it). File rules
# stay in preview until the media backup is verified, then True (owner steps §4a).
LIFECYCLE_HOLD_ROOT=/opt/elrezeiky/app/media_hold
LIFECYCLE_FILE_RULES_ENABLED=False
# Project 5 usage-instruction slip (read-only screen, ships dark)
USAGE_PRINT_ENABLED=False
# staff phone alerts over WhatsApp — needs the staff-alerts number + approved templates
PHONE_ALERTS_SEND_ENABLED=False
# 09:00 Cairo morning brief to recipients — same WhatsApp prerequisites
MORNING_BRIEF_SEND_ENABLED=False

# ── Internal switches that are ON by default (Postgres-side only, none writes to SOFTECH) ──
# Listed so the owner sees them; these are the code defaults, change only on purpose.
# high-confidence A/P matches approved automatically (the writer stays gated above)
AP_RECONCILE_AUTO_APPROVE=True
# duplicate-customer review queue (the merge write stays gated above)
CUSTOMER_MERGE_QUEUE_ENABLED=True
CUSTOMER_STATUS_DRIFT_CHECK_ENABLED=True
REPLACEMENT_DAILY_CHECK_ENABLED=True
STOCK_AUDIT_ENABLED=True
GAMIFICATION_ENABLED=True
POS_ENFORCE_STOCK=True
# flags only; PHANTOM_APPLY_REDUCTION stays False (code default)
PHANTOM_SCAN_IN_ENGINE_RUN=True
# one message of each type per number per 10 minutes (owner rule); the code default
SEND_MIN_INTERVAL_SECONDS=600

# ── External channels: EMPTY until cutover 11.7 (nothing reaches customers from a rehearsal) ──
# the SAME Fernet key as the office (encrypted channel credentials)
# Fernet key, 44 characters. EMPTY or a valid key: anything else stops `check --deploy` (omni.E001).
# Copy it from the password manager; generate once with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# then `manage.py omni_credentials` must print OK (go-live status doc, owner step).
OMNI_CREDENTIALS_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_APP_SECRET=
META_GRAPH_VERIFY_TOKEN=
REFILL_REMINDER_SEND_ENABLED=False
# W-1: OFF until the SMS company is chosen
SMS_PROVIDER=
AMI_HOST=
AMI_USER=
AMI_SECRET=
# SIP or PJSIP (must match Issabel's extensions); dial context for click-to-dial
AMI_CHANNEL_TECH=SIP
AMI_DIAL_CONTEXT=
ISSABEL_CDR_USER=
ISSABEL_CDR_PASSWORD=
# Call recordings: read-only SFTP user on Issabel (runbook «Issabel recordings»)
PBX_RECORDINGS_ROOT=/var/spool/asterisk/monitor
PBX_RECORDINGS_SFTP_HOST=
PBX_RECORDINGS_SFTP_USER=
PBX_RECORDINGS_SFTP_PASSWORD=
# Browser phone (WebRTC): Issabel's secure websocket, e.g. wss://pbx.example:8089/ws — empty = off
PBX_WEBRTC_WSS_URL=
PBX_WEBRTC_SIP_DOMAIN=
# Instant Gemini transcription after each call (paid per call)
CALLCENTER_AUTO_TRANSCRIBE=False
# the office pair — a new pair forces every user to re-subscribe
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# ── Local OCR (runbook §8.4) ─────────────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract
# empty → the project's ocr_tessdata/ (copied by hand, git-ignored)
TESSERACT_TESSDATA_PREFIX=
OMP_THREAD_LIMIT=1
PADDLE_OCR_URL=http://127.0.0.1:8077/boxes
# tesseract = 100% local
INVOICE_OCR_ENGINE=auto
INVOICE_OCR_ESCALATE_THRESHOLD=0.6
# empty forbids cloud OCR
GEMINI_API_KEY=
OPENAI_API_KEY=
# Whisper: this server only QUEUES calls (cheap); the office PC transcribes them
# 02:00–06:00 with run_whisper_queue (owner decision 2026-11-09; 8 GB RAM here).
WHISPER_ENABLED=True
WHISPER_LAUNCH_RUNNER=False
