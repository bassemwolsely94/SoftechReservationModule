# ── ElRezeiky — STAGING / UAT environment template ───────────────────────────
# Copy to .env on the staging machine. Every value marked CHANGE must be filled.
# Goal: testers can use every screen while NOTHING can be written to the
# production SOFTECH databases. See docs/architecture/SECURITY_HARDENING.md.
# Comments go on their own line: python-decouple keeps anything after = as the value, so a note beside a value stops the app at boot.

# ── Django ───────────────────────────────────────────────────────────────────
DEBUG=False
# Django admin has no 2FA — on only for a maintenance window (N0/H9)
DJANGO_ADMIN_ENABLED=False
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE-to-a-long-random-value
# CHANGE
ALLOWED_HOSTS=uat.example.com,localhost,127.0.0.1
# CHANGE
CSRF_TRUSTED_ORIGINS=https://uat.example.com
# CHANGE (links in WhatsApp / portal)
FRONTEND_BASE_URL=https://uat.example.com
# Nginx / tunnel terminates TLS and sets X-Forwarded-Proto
BEHIND_HTTPS_PROXY=True
# ONLY if our nginx (elrezeiky-proxy-headers.conf) is the sole way in; False if a tunnel reaches Daphne directly
NETWORK_HEADER_TRUSTED=True
# zone used when the header is not trusted (never leave internal on a server)
NETWORK_UNTRUSTED_ZONE=external
# off | log (N1) | enforce (N3)
NETWORK_POLICY_ENFORCEMENT=log
# N3: same value as in /etc/nginx/elrezeiky-proxy-key.conf; required to enforce
NETWORK_PROXY_KEY=<openssl rand -hex 32>
# N3: nginx-proxy-headers.conf now includes /etc/nginx/elrezeiky-proxy-key.conf - create it (runbook, Batch N3 step 1) BEFORE reloading nginx or `nginx -t` fails.
# proxies appending to X-Forwarded-For (2 if a tunnel also appends)
NUM_PROXIES=1
# run `manage.py run_scheduler` as its own process
SCHEDULER_AUTOSTART=False

# Nginx serves uploads after Django checks the signature
MEDIA_ACCEL_REDIRECT=True

# ── Access control ───────────────────────────────────────────────────────────
# testers only reach modules their role is granted
RBAC_ENFORCEMENT=enforce
LOYALTY_ADJUST_ROLES=admin

# ── PostgreSQL (a SEPARATE staging database — never the production one) ─────
PG_NAME=elrezeiky_uat
PG_USER=elrezeiky_uat
PG_PASSWORD=CHANGE
PG_HOST=localhost
PG_PORT=5432

# ── SOFTECH ──────────────────────────────────────────────────────────────────
# 1) Global kill-switch: every INSERT/UPDATE/DELETE/EXEC is refused on every
#    SOFTECH connection, whatever the flags below say.
SOFTECH_READ_ONLY=True
# P-54: never the writer instance (config/writers.py) — a second, independent lock.
WRITER_INSTANCE=False
# 2) Point at a cloned/test ASE if you have one; otherwise production HQ with a
#    SELECT-only login (ask the SOFTECH DBA — this is the database-level guarantee).
SYBASE_HOST=CHANGE
SYBASE_PORT=5000
SYBASE_USER=CHANGE-select-only-login
SYBASE_PASSWORD=CHANGE
SOFTECH_PROFILE=test
# 3) Branch servers: send every branch connection to the test host instead of the
#    production addresses stored in the Branch table.
SOFTECH_BRANCH_HOST_OVERRIDE=CHANGE-test-host

# ── Every SOFTECH writer OFF (belt and braces under SOFTECH_READ_ONLY) ────────
POS_WRITER_ENABLED=False
POS_CANCEL_WRITE_ENABLED=False
SALES_RATE_WRITER_ENABLED=False
ISR_WRITER_ENABLED=False
ISR_AUTO_APPROVE_ENABLED=False
COVERAGE_WRITER_ENABLED=False
COVERAGE_AUTO_TOPUP_ENABLED=False
INVOICE_WRITER_ENABLED=False
INVOICE_SUPPLIER_ITEM_WRITE_ENABLED=False
AP_RECONCILE_WRITER_ENABLED=False
AP_RECONCILE_UPDATE_PATIENTDATA=False
INSURANCE_SOFTECH_WRITE_ENABLED=False
SHORTAGE_SOFTECH_WRITE_ENABLED=False
POS_OFFERS_POSDISCP_WRITE_ENABLED=False
POS_OFFERS_PROMO_WRITE_ENABLED=False
REPLACEMENT_POSTING_ENABLED=False
DEMAND_ENGINE_SCHEDULE_ENABLED=False
# finance GL 08:30 daily drafting (draft-now button works regardless)
GL_DRAFTING_SCHEDULE_ENABLED=False
PRICING_SOFTECH_WRITE_ENABLED=False
REPLICATION_REPAIR_ENABLED=False
LOYALTY_SOFTECH_WRITE_ENABLED=False
PERSONAL_COMMENT_WRITE_ENABLED=False
COVERAGE_WRITE_MAXQTY=False
POS_OFFERS_EXECUTION_ENABLED=False
CUSTOMER_BRANCH_COPY_WRITE_ENABLED=False
POINTS_REMOVAL_WRITE_ENABLED=False
CUSTOMER_MERGE_WRITE_ENABLED=False

# ── External channels: leave EMPTY in UAT so nothing reaches real customers ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_APP_SECRET=
META_GRAPH_VERIFY_TOKEN=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Fernet key, 44 characters. EMPTY or a valid key: anything else stops `check --deploy` (omni.E001).
# Copy it from the password manager; generate once with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# then `manage.py omni_credentials` must print OK (go-live status doc, owner step).
OMNI_CREDENTIALS_KEY=
AMI_HOST=
AMI_USER=
AMI_SECRET=
ISSABEL_CDR_USER=
ISSABEL_CDR_PASSWORD=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Tax Invoicing (doc 36): sending to the tax authority stays off until the real seal test passes.
TAX_ETA_SUBMIT_ENABLED=False
TAX_ERECEIPT_SUBMIT_ENABLED=False
TAX_ETA_CODING_ENABLED=False
# Production sends need this too; pre-production does not (TAX_ETA_ENVIRONMENT=preprod).
TAX_ETA_PRODUCTION_ALLOWED=False
