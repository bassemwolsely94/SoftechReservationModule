# ── ElRezeiky — STAGING / UAT environment template ───────────────────────────
# Copy to .env on the staging machine. Every value marked CHANGE must be filled.
# Goal: testers can use every screen while NOTHING can be written to the
# production SOFTECH databases. See docs/architecture/SECURITY_HARDENING.md.

# ── Django ───────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=CHANGE-to-a-long-random-value   # python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=uat.example.com,localhost,127.0.0.1           # CHANGE
CSRF_TRUSTED_ORIGINS=https://uat.example.com                 # CHANGE
FRONTEND_BASE_URL=https://uat.example.com                    # CHANGE (links in WhatsApp / portal)
BEHIND_HTTPS_PROXY=True          # Nginx / tunnel terminates TLS and sets X-Forwarded-Proto
SCHEDULER_AUTOSTART=False        # run `manage.py run_scheduler` as its own process

MEDIA_ACCEL_REDIRECT=True       # Nginx serves uploads after Django checks the signature

# ── Access control ───────────────────────────────────────────────────────────
RBAC_ENFORCEMENT=enforce         # testers only reach modules their role is granted
LOYALTY_ADJUST_ROLES=admin

# ── PostgreSQL (a SEPARATE staging database — never the production one) ─────
PG_NAME=elrezeiky_uat
PG_USER=elrezeiky_uat
PG_PASSWORD=CHANGE
PG_HOST=localhost
PG_PORT=5432

# ── SOFTECH ──────────────────────────────────────────────────────────────────
# 1) Global kill-switch: every INSERT/UPDATE/DELETE/EXEC is refused on every
#    SOFTECH connection, whatever the flags below say.
SOFTECH_READ_ONLY=True
# 2) Point at a cloned/test ASE if you have one; otherwise production HQ with a
#    SELECT-only login (ask the SOFTECH DBA — this is the database-level guarantee).
SYBASE_HOST=CHANGE
SYBASE_PORT=5000
SYBASE_USER=CHANGE-select-only-login
SYBASE_PASSWORD=CHANGE
SOFTECH_PROFILE=test
# 3) Branch servers: send every branch connection to the test host instead of the
#    production addresses stored in the Branch table.
SOFTECH_BRANCH_HOST_OVERRIDE=CHANGE-test-host

# ── Every SOFTECH writer OFF (belt and braces under SOFTECH_READ_ONLY) ────────
POS_WRITER_ENABLED=False
POS_CANCEL_WRITE_ENABLED=False
SALES_RATE_WRITER_ENABLED=False
ISR_WRITER_ENABLED=False
ISR_AUTO_APPROVE_ENABLED=False
COVERAGE_WRITER_ENABLED=False
COVERAGE_AUTO_TOPUP_ENABLED=False
INVOICE_WRITER_ENABLED=False
INVOICE_SUPPLIER_ITEM_WRITE_ENABLED=False
AP_RECONCILE_WRITER_ENABLED=False
AP_RECONCILE_UPDATE_PATIENTDATA=False
INSURANCE_SOFTECH_WRITE_ENABLED=False
SHORTAGE_SOFTECH_WRITE_ENABLED=False
POS_OFFERS_POSDISCP_WRITE_ENABLED=False
POS_OFFERS_PROMO_WRITE_ENABLED=False
REPLACEMENT_POSTING_ENABLED=False
DEMAND_ENGINE_SCHEDULE_ENABLED=False
PRICING_SOFTECH_WRITE_ENABLED=False
REPLICATION_REPAIR_ENABLED=False
LOYALTY_SOFTECH_WRITE_ENABLED=False
PERSONAL_COMMENT_WRITE_ENABLED=False

# ── External channels: leave EMPTY in UAT so nothing reaches real customers ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_APP_SECRET=
META_GRAPH_VERIFY_TOKEN=
OMNI_CREDENTIALS_KEY=CHANGE      # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AMI_HOST=
AMI_USER=
AMI_SECRET=
ISSABEL_CDR_USER=
ISSABEL_CDR_PASSWORD=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
