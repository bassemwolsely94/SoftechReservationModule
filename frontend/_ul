/* ─── Base ──────────────────────────────────────────────────────────────────── */

/* ─── RefreshButton loading bar animation ───────────────────────────────────── */

@keyframes refresh-sweep {
  0%   {
    left: -55%;
    width: 45%;
  }

  65%  {
    left: 85%;
    width: 60%;
  }

  100% {
    left: 110%;
    width: 45%;
  }
}

.refresh-btn-bar {
  position: absolute;
  bottom: 0;
  height: 2px;
  background-color: currentColor;
  opacity: 0.45;
  border-radius: 9999px;
  animation: refresh-sweep 1.1s ease-in-out infinite;
}

/* ─── Component layer ───────────────────────────────────────────────────────── */

/* ─── Utility layer ─────────────────────────────────────────────────────────── */

/* ─── Keyframes ─────────────────────────────────────────────────────────────── */

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to   {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(12px);
  }

  to   {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-12px);
  }

  to   {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes shimmer {
  0%   {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0% 50%;
  }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }

  to   {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes toastIn {
  from {
    opacity: 0;
    transform: translateX(100%);
  }

  to   {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes toastOut {
  from {
    opacity: 1;
    transform: translateX(0);
  }

  to   {
    opacity: 0;
    transform: translateX(100%);
  }
}

/* ─── Animation classes (supplement Tailwind) ───────────────────────────────── */

.animate-fade-in     {
  animation: fadeIn     0.25s ease-out both;
}

.animate-slide-in    {
  animation: slideIn    0.22s ease-out both;
}

.animate-slide-left  {
  animation: slideInLeft 0.22s ease-out both;
}

.animate-scale-in    {
  animation: scaleIn    0.2s  ease-out both;
}

.animate-toast-in    {
  animation: toastIn    0.3s  ease-out both;
}

.animate-toast-out   {
  animation: toastOut   0.25s ease-in  both;
}

/* Stagger children — add to a parent, children get sequential delays */

.stagger > *:nth-child(1) {
  animation-delay: 0ms;
}

.stagger > *:nth-child(2) {
  animation-delay: 40ms;
}

.stagger > *:nth-child(3) {
  animation-delay: 80ms;
}

.stagger > *:nth-child(4) {
  animation-delay: 120ms;
}

.stagger > *:nth-child(5) {
  animation-delay: 160ms;
}

.stagger > *:nth-child(6) {
  animation-delay: 200ms;
}

/* ─── Toast portal ───────────────────────────────────────────────────────────── */

#toast-root {
  position: fixed;
  bottom: 1.5rem;
  left: 1.5rem;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  pointer-events: none;
}

/* ─── Mobile responsive overrides ───────────────────────────────────────────── */

@media (max-width: 640px) {
  .card{
    border-radius: 0.75rem;
    padding: 1rem;
  }

  .page-body{
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .data-table thead th,
  .data-table tbody td{
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    padding-top: 0.625rem;
    padding-bottom: 0.625rem;
  }
}

/* ─── Sticky table headers (global — every module) ───────────────────────────
   Column titles stay pinned while scrolling long tables. Each table's horizontal-
   scroll wrapper (overflow-x-auto) is also a vertical scroll container, so we bound
   its height to the viewport — the header then sticks to the top of that scroll
   area. Short tables never reach the cap, so they render exactly as before.
   Works for both border-collapse 'separate' (sticky thead) and 'collapse' (sticky
   th) tables. Each header keeps its OWN background (a bg-* class on thead/tr/th
   wins by specificity); transparent headers fall back to white so rows can't bleed
   through. Opt a single table out with the `.no-sticky-head` class on its wrapper. */

thead {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgb(var(--c-surface));
}

thead th {
  position: sticky;
  top: 0;
  background: inherit;
}

.overflow-x-auto:has(> table):not(.no-sticky-head),
.overflow-auto:has(> table):not(.no-sticky-head),
.overflow-y-auto:has(> table):not(.no-sticky-head) {
  max-height: calc(100dvh - 12rem);
}

.no-sticky-head thead,
.no-sticky-head thead th {
  position: static;
}

/* ─── Print ──────────────────────────────────────────────────────────────────── */

@media print {
  .no-print {
    display: none !important;
  }

  body {
    background: white;
  }

  .card {
    box-shadow: none;
    border: 1px solid #e5e7eb;
  }

  /* Never clip/scroll tables when printing */

  thead, thead th {
    position: static;
  }

  .overflow-x-auto:has(> table),
  .overflow-auto:has(> table),
  .overflow-y-auto:has(> table) {
    max-height: none;
  }
}

