/* ─── Arabic webfonts: Cairo (default/fallback) + Tajawal (optional choice) ─── */

/* ─── ElRezeiky brand fonts (self-hosted, files in frontend/public/fonts/) ─────
     Jozoor              → Arabic
     Harabara Mais Demo  → Latin / headings
     Berlin Sans FB      → Numbers (Regular + Bold)
   .woff2 preferred, original .otf/.ttf kept as fallback.
   ---------------------------------------------------------------------------- */

@font-face {
  font-family: 'Jozoor';

  src: url('/fonts/Jozoor.woff2') format('woff2'),
       url('/fonts/Jozoor.otf')   format('opentype');

  font-weight: 400 700;

  font-display: swap;
}

@font-face {
  font-family: 'Harabara Mais Demo';

  src: url('/fonts/HarabaraMaisDemo.woff2') format('woff2'),
       url('/fonts/HarabaraMaisDemo.otf')   format('opentype');

  font-weight: 400 700;

  font-display: swap;
}

@font-face {
  font-family: 'Berlin Sans FB';

  src: url('/fonts/BerlinSansFB.woff2') format('woff2'),
       url('/fonts/BerlinSansFB.ttf')   format('truetype');

  font-weight: 400;

  font-display: swap;
}

@font-face {
  font-family: 'Berlin Sans FB';

  src: url('/fonts/BerlinSansFB-Bold.woff2') format('woff2'),
       url('/fonts/BerlinSansFB-Bold.ttf')   format('truetype');

  font-weight: 700;

  font-display: swap;
}

:root {
  /* Fonts. --font-ar is swapped at runtime by the Appearance settings page
     (Cairo default — clearest for dense Arabic UI; Jozoor/Tajawal optional).
     --font-ui embeds --font-ar so changing the Arabic font updates the body too:
     Latin → Harabara, Arabic → chosen font. */
  --font-en:  'Harabara Mais Demo', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-ar:  'Cairo', 'Tajawal', sans-serif;
  --font-ui:  'Harabara Mais Demo', var(--font-ar), system-ui, sans-serif;
  --font-num: 'Berlin Sans FB', 'Harabara Mais Demo', 'Cairo', sans-serif;
  /* ── Brand palette defaults (R G B triplets; overridden at runtime by
     src/theme/theme.js). These match the navy scale in tailwind.config.js. ── */
  --c-brand-50:  238 243 251;
  --c-brand-100: 211 224 244;
  --c-brand-200: 167 193 232;
  --c-brand-300: 111 155 214;
  --c-brand-400: 56 128 187;
  /* sky  */
  --c-brand-500: 28 86 149;
  --c-brand-600: 2 40 113;
  /* navy — primary */
  --c-brand-700: 2 32 93;
  --c-brand-800: 1 24 69;
  --c-brand-900: 1 17 47;
  --c-brand-sky: 56 128 187;
  --c-brand-red: 234 0 0;
  --c-danger:    234 0 0;
  /* Convenience solid hexes for inline/canvas use */
  --brand-navy: #022871;
  --brand-sky:  #3880bb;
  --brand-red:  #ea0000;
  /* ── Semantic surface tokens (LIGHT — default) ───────────────────────────────
     Personal light/dark mode (src/theme/theme.js → applyMode) flips these by
     setting data-theme="dark" on <html>. Brand colors above are unaffected —
     they read in both modes. New code should prefer these Tailwind aliases
     (bg-surface / text-content / border-line …) over literal bg-white/gray-*
     so it themes automatically. R G B triplets → `/<alpha>` modifiers work. */
  --c-bg:          246 248 252;
  /* page background (#f6f8fc) */
  --c-surface:     255 255 255;
  /* cards, header, inputs */
  --c-surface-2:   249 250 251;
  /* subtle fill — table head, gray-50 */
  --c-surface-3:   243 244 246;
  /* hover/active fill — gray-100 */
  --c-content:      15  27  51;
  /* primary text (#0f1b33) */
  --c-muted:        75  85  99;
  /* secondary text — gray-600 */
  --c-faint:       156 163 175;
  /* tertiary text — gray-400 */
  --c-line:        229 231 235;
  /* borders — gray-200 */
  --c-line-soft:   243 244 246;
  /* soft borders — gray-100 */
  --c-line-strong: 209 213 219;
  /* strong borders — gray-300 */
  --c-scroll:      209 213 219;
  /* scrollbar thumb */
  color-scheme: light;
}

/* ── Semantic surface tokens (DARK) ─────────────────────────────────────────────
   Navy-tinted dark neutrals so the palette stays on-brand. Only the surface
   tokens are overridden; the brand scale is intentionally left as-is. */

:root[data-theme='dark'] {
  --c-bg:           15  20  32;
  /* deep navy-black (#0f1420) */
  --c-surface:      22  28  44;
  /* raised surface (#161c2c) */
  --c-surface-2:    28  35  54;
  /* subtle fill (#1c2336) */
  --c-surface-3:    38  48  72;
  /* hover/active fill (#263048) */
  --c-content:     226 232 240;
  /* primary text — slate-200 */
  --c-muted:       148 163 184;
  /* secondary text — slate-400 */
  --c-faint:       100 116 139;
  /* tertiary text — slate-500 */
  --c-line:         42  52  76;
  /* borders (#2a344c) */
  --c-line-soft:    33  41  62;
  /* soft borders (#21293e) */
  --c-line-strong:  58  71 102;
  /* strong borders (#3a4766) */
  --c-scroll:       58  71 102;
  /* scrollbar thumb */
  color-scheme: dark;
}

